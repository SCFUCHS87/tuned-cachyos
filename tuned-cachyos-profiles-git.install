_configure_ppd() {
  mode=$1
  ppd_conf=/etc/tuned/ppd.conf
  backup_conf=/etc/tuned/ppd.conf.tuned-cachyos.bak

  if [ -e "$ppd_conf" ] && grep -q 'managed by tuned-cachyos-profiles-git' "$ppd_conf"; then
    return 0
  fi

  if [ "$mode" = upgrade ] && [ -e "$ppd_conf" ]; then
    cat << 'EOF'
==> Existing /etc/tuned/ppd.conf is not managed by tuned-cachyos-profiles-git.
    Leaving it untouched to preserve local changes.
EOF
    return 0
  fi

  if [ -e "$ppd_conf" ] && [ ! -e "$backup_conf" ]; then
    cp -a "$ppd_conf" "$backup_conf"
  fi

  install -d /etc/tuned
  cat > "$ppd_conf" << 'EOF'
# managed by tuned-cachyos-profiles-git
[main]
default=balanced
battery_detection=true
sysfs_acpi_monitor=false

[profiles]
# PPD state = TuneD profile (on AC)
power-saver=laptop-ac-powersaver-cachyos
balanced=laptop-ac-balanced-cachyos
performance=throughput-performance-cachyos

[battery]
# PPD state = TuneD profile (on battery)
power-saver=laptop-battery-powersaver-cachyos
balanced=battery-balanced-cachyos
performance=balanced-cachyos
EOF
}

post_install() {
  _configure_ppd install
  cat << 'EOF'
==> tuned-cachyos-profiles installed

  KDE PowerDevil / PPD mapping written to:
    /etc/tuned/ppd.conf

  If an existing non-CachyOS ppd.conf was found, it was backed up once to:
    /etc/tuned/ppd.conf.tuned-cachyos.bak

  Enable TuneD if not already running:
    sudo systemctl enable --now tuned

  TuneD will pick up the active PPD state automatically via ppd.conf.
  No manual profile switching needed if you use KDE PowerDevil.

  NOTE: Existing CachyOS-managed ppd.conf files are preserved on upgrade
  so local mapping edits are not overwritten.

  NOTE: VM tuning (swappiness, vfs_cache_pressure) was calibrated for
  64 GB RAM. Edit the [sysctl] section in any profile at
  /etc/tuned/profiles/<profile>/tuned.conf if needed. Your edits
  survive upgrades via pacman's .pacnew mechanism.

  Verify settings:
    tuned-adm active
    cat /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference | sort -u
    sysctl vm.swappiness
EOF
}

post_upgrade() {
  _configure_ppd upgrade
  cat << 'EOF'
==> tuned-cachyos-profiles upgraded

  CachyOS-managed /etc/tuned/ppd.conf files are preserved on upgrade.
  Non-managed ppd.conf files are left untouched to protect local changes.
EOF
}

post_remove() {
  ppd_conf=/etc/tuned/ppd.conf
  backup_conf=/etc/tuned/ppd.conf.tuned-cachyos.bak

  if [ -e "$backup_conf" ]; then
    if [ ! -e "$ppd_conf" ] || grep -q 'managed by tuned-cachyos-profiles-git' "$ppd_conf"; then
      cp -a "$backup_conf" "$ppd_conf"
      rm -f "$backup_conf"
      cat << 'EOF'
==> tuned-cachyos-profiles removed

  Restored previous /etc/tuned/ppd.conf from backup.
EOF
    else
      cat << 'EOF'
==> tuned-cachyos-profiles removed

  Left /etc/tuned/ppd.conf untouched because it is not managed by
  tuned-cachyos-profiles-git. The original backup remains at:
    /etc/tuned/ppd.conf.tuned-cachyos.bak
EOF
    fi
  elif [ -e "$ppd_conf" ] && grep -q 'managed by tuned-cachyos-profiles-git' "$ppd_conf"; then
    rm -f "$ppd_conf"
    cat << 'EOF'
==> tuned-cachyos-profiles removed

  Removed the CachyOS-managed /etc/tuned/ppd.conf.
  Reinstall tuned-ppd if you want its default mapping restored.
EOF
  else
    cat << 'EOF'
==> tuned-cachyos-profiles removed

  Left /etc/tuned/ppd.conf untouched because it was not recognized as
  managed by tuned-cachyos-profiles-git and no backup was available.
EOF
  fi
}
