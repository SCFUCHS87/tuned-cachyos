_configure_ppd() {
  ppd_conf=/etc/tuned/ppd.conf
  backup_conf=/etc/tuned/ppd.conf.tuned-cachyos.bak

  if [ -e "$ppd_conf" ] && ! grep -q 'laptop-battery-powersaver-cachyos' "$ppd_conf"; then
    if [ ! -e "$backup_conf" ]; then
      cp -a "$ppd_conf" "$backup_conf"
    fi
  fi

  install -d /etc/tuned
  cat > "$ppd_conf" <<'EOF'
[main]
# The default PPD profile
default=balanced
battery_detection=true
sysfs_acpi_monitor=false

[profiles]
# PPD = TuneD
power-saver=laptop-ac-powersaver-cachyos
balanced=laptop-ac-balanced-cachyos
performance=throughput-performance-cachyos

[battery]
# PPD = TuneD
power-saver=laptop-battery-powersaver-cachyos
balanced=battery-balanced-cachyos
performance=balanced-cachyos
EOF
}

_print_post_install() {
  cat <<'EOF'
==> tuned-cachyos-profiles installed

  Enable TuneD if not already running:
    sudo systemctl enable --now tuned

  KDE PowerDevil / PPD mapping has been configured in:
    /etc/tuned/ppd.conf

  If an existing non-CachyOS ppd.conf was present, it was backed up to:
    /etc/tuned/ppd.conf.tuned-cachyos.bak

  To activate a profile manually:
    sudo tuned-adm profile <profile-name>
    tuned-adm list

  NOTE: VM tuning (swappiness, vfs_cache_pressure) was calibrated for
  high-RAM systems (64 GB). Adjust the [sysctl] section in any profile
  at /etc/tuned/profiles/<profile>/tuned.conf if needed. Your edits
  are preserved on upgrades via pacman's .pacnew mechanism.

  Verify settings took effect:
    cat /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference | sort -u
    sysctl vm.swappiness
EOF
}

post_install() {
  _configure_ppd
  _print_post_install
}

post_upgrade() {
  _configure_ppd
  _print_post_install
}

post_remove() {
  ppd_conf=/etc/tuned/ppd.conf
  backup_conf=/etc/tuned/ppd.conf.tuned-cachyos.bak

  if [ -e "$backup_conf" ]; then
    cp -a "$backup_conf" "$ppd_conf"
    cat <<'EOF'
==> Restored previous /etc/tuned/ppd.conf from:
    /etc/tuned/ppd.conf.tuned-cachyos.bak
EOF
  else
    cat <<'EOF'
==> tuned-cachyos-profiles removed

  /etc/tuned/ppd.conf may still reference CachyOS TuneD profiles.
  Reinstall tuned-ppd or edit /etc/tuned/ppd.conf if KDE PowerDevil
  profile switching stops working.
EOF
  fi
}
